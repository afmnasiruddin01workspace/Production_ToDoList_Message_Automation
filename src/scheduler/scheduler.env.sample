# 03-scheduler settings. Copy to scheduler.env (git-ignored) and adjust.
# Holds no secrets - the real ones stay in .secrets/ - but it is git-ignored so each
# machine can differ.

# Daily fire time, local clock. The machine timezone is Asia/Dhaka (+06:00), so this
# is already the project timezone. Read by install_task.ps1.
SCHED_TIME=10:00

# Model for the headless run. Sonnet is the default: cheaper, and the work is scripted.
SCHED_MODEL=sonnet

# Hard wall-clock kill for the whole pipeline, minutes. Guards against an unattended
# Google sign-in prompt or a hung Chrome.
SCHED_TIMEOUT_MIN=25

# Attempts per day before the owner is alerted. The retries run inside run_daily.ps1 itself
# (15 minutes apart, SCHED_RETRY_WAIT_SEC), not Task Scheduler's RestartCount - the headless
# launcher hides the exit code from it - so 3 = the first run plus two self-retries.
SCHED_MAX_ATTEMPTS=3

# Show the console even on a successful run. 1 while testing, 0 once it is trusted.
SCHED_VISIBLE=0

# Alert channels on failure. Set any to 0 to silence it.
SCHED_ALERT_TOAST=1
SCHED_ALERT_WHATSAPP=1
SCHED_ALERT_WINDOW=1

# How long run_log.json entries and per-run transcripts are kept, days.
SCHED_RETENTION_DAYS=60

# v2.0: the email channel (module 04), run directly - no Claude cost. 1 = on, 0 = off.
SCHED_EMAIL=1

# v3.0: email's own time. A second task, ToDo-Email-Daily, sends email at this time and the SCHED_TIME
# run does WhatsApp only. If today's list is missing then, the email run rebuilds it first (module 01
# only, about $0.2-0.3). off = email straight after WhatsApp in the SCHED_TIME run (v2.0).
# Read by install_task.ps1 - re-run it after changing this.
SCHED_EMAIL_TIME=13:30

# v3.0: minutes the email run waits for a lock held by another run (a late SCHED_TIME run, a manual-UI job).
SCHED_EMAIL_LOCK_WAIT_MIN=30

# Backstop for the email step, minutes. Module 04 has its own, shorter, ceiling.
SCHED_EMAIL_TIMEOUT_MIN=10

# Seconds between attempts. Leave at 900; lowered only by tests.
SCHED_RETRY_WAIT_SEC=900
