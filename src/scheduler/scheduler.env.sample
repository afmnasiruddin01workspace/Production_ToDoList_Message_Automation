# 03-scheduler settings. Copy to scheduler.env (git-ignored) and adjust.
# Holds no secrets - the real ones stay in .secrets/ - but it is git-ignored so each
# machine can differ.

# Daily fire time, local clock. The machine timezone is Asia/Dhaka (+06:00), so this
# is already the project timezone. Read by install_task.ps1.
SCHED_TIME=10:00

# Model for the headless run. Sonnet is the default: cheaper, and the work is scripted.
SCHED_MODEL=sonnet

# Hard wall-clock kill for the whole pipeline, minutes. Guards against an unattended
# Google sign-in prompt or a hung Chrome.
SCHED_TIMEOUT_MIN=25

# Attempts per day before the owner is alerted. Task Scheduler supplies the retries
# (2 restarts, 15 min apart), so 3 = the initial run plus those two.
SCHED_MAX_ATTEMPTS=3

# Show the console even on a successful run. 1 while testing, 0 once it is trusted.
SCHED_VISIBLE=0

# Alert channels on failure. Set any to 0 to silence it.
SCHED_ALERT_TOAST=1
SCHED_ALERT_WHATSAPP=1
SCHED_ALERT_WINDOW=1

# How long run_log.json entries and per-run transcripts are kept, days.
SCHED_RETENTION_DAYS=60
